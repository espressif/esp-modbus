menu "Modbus TCP to Serial Gateway Configuration"

    config MB_GATEWAY_TCP_UID
        int "Gateway TCP Unit ID"
        range 0 247
        default 0
        depends on FMB_TCP_UID_ENABLED
        help
            TCP Unit ID accepted by the gateway. Use 0 to accept any MBAP Unit ID
            and forward it as the downstream serial Modbus slave address.

    config MB_MAX_CYCLE_TIMEOUT_MS
        int "Gateway working timeout before destroy"
        range 1 2147483647
        default 60000
        depends on FMB_TCP_UID_ENABLED
        depends on MB_GATEWAY_ALLOW_DESTROY_SELF_TEST
        help
            Means the period of time (in milliseconds) while the gateway is able to transfer data before destroy.

    config MB_GATEWAY_MAX_REGISTERS
        int "Maximum registers per forwarded request"
        range 1 125
        default 125
        help
            Maximum number of registers that the gateway forwards in one request.

    config MB_GATEWAY_MAX_COILS
        int "Maximum coils per forwarded request"
        range 1 2000
        default 2000
        help
            Maximum number of coils or discrete inputs that the gateway forwards in one request.

    config MB_GATEWAY_ALLOW_DESTROY_SELF_TEST
        bool "Allow destroy gateway in self test"
        default n
        help
            Once enabled, allows to destroy gateway instance after exit condition (only for test).

    config MB_UART_PORT_ONE
        bool
        default y
        depends on (ESP_CONSOLE_UART_NUM !=1) && (SOC_UART_HP_NUM > 1)

    config MB_UART_PORT_TWO
        bool
        default y
        depends on (ESP_CONSOLE_UART_NUM !=2) && (SOC_UART_HP_NUM > 2)

    config MB_UART_PORT_NUM
        int "UART port number"
        range 0 2 if MB_UART_PORT_TWO
        default 2 if MB_UART_PORT_TWO
        range 0 1 if MB_UART_PORT_ONE
        default 1 if MB_UART_PORT_ONE
        help
            UART communication port number for the downstream Modbus serial bus.

    config MB_UART_BAUD_RATE
        int "UART communication speed"
        range 1200 115200
        default 115200
        help
            UART communication speed for the downstream Modbus serial bus.

    config MB_UART_RXD
        int "UART RXD pin number"
        range 0 34 if IDF_TARGET_ESP32
        range 0 23 if IDF_TARGET_ESP32C6
        range 0 56 if IDF_TARGET_ESP32P4
        range 0 28 if IDF_TARGET_ESP32C5
        default 22 if IDF_TARGET_ESP32 || IDF_TARGET_ESP32C6 || IDF_TARGET_ESP32P4
        range 0 46 if IDF_TARGET_ESP32S2
        range 0 47 if IDF_TARGET_ESP32S3
        range 0 19 if IDF_TARGET_ESP32C3
        range 0 20 if IDF_TARGET_ESP32C2
        range 0 27 if IDF_TARGET_ESP32H2
        range 0 21 if IDF_TARGET_ESP32C61
        default 8 if IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32H2
        default 8 if IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C2 || IDF_TARGET_ESP32C5
        default 8 if IDF_TARGET_ESP32C61
        help
            GPIO number for UART RX pin.

    config MB_UART_TXD
        int "UART TXD pin number"
        range 0 34 if IDF_TARGET_ESP32
        range 0 23 if IDF_TARGET_ESP32C6
        range 0 56 if IDF_TARGET_ESP32P4
        range 0 28 if IDF_TARGET_ESP32C5
        default 23 if IDF_TARGET_ESP32 || IDF_TARGET_ESP32C6 || IDF_TARGET_ESP32P4
        range 0 46 if IDF_TARGET_ESP32S2
        range 0 47 if IDF_TARGET_ESP32S3
        range 0 19 if IDF_TARGET_ESP32C3
        range 0 20 if IDF_TARGET_ESP32C2
        range 0 27 if IDF_TARGET_ESP32H2
        range 0 21 if IDF_TARGET_ESP32C61
        default 9 if IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32H2
        default 9 if IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C2 || IDF_TARGET_ESP32C5
        default 9 if IDF_TARGET_ESP32C61
        help
            GPIO number for UART TX pin.

    config MB_UART_RTS
        int "UART RTS pin number"
        range 0 34 if IDF_TARGET_ESP32
        range 0 23 if IDF_TARGET_ESP32C6
        range 0 56 if IDF_TARGET_ESP32P4
        range 0 28 if IDF_TARGET_ESP32C5
        default 20 if IDF_TARGET_ESP32P4
        default 18 if IDF_TARGET_ESP32 || IDF_TARGET_ESP32C6
        range 0 46 if IDF_TARGET_ESP32S2
        range 0 47 if IDF_TARGET_ESP32S3
        range 0 19 if IDF_TARGET_ESP32C3
        range 0 20 if IDF_TARGET_ESP32C2
        range 0 27 if IDF_TARGET_ESP32H2
        range 0 21 if IDF_TARGET_ESP32C61
        default 10 if IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32H2
        default 10 if IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C2 || IDF_TARGET_ESP32C5
        default 10 if IDF_TARGET_ESP32C61
        help
            GPIO number for UART RTS pin connected to the RS485 transceiver ~RE/DE.

    choice MB_COMM_MODE
        prompt "Downstream serial Modbus mode"
        default MB_COMM_MODE_RTU if CONFIG_FMB_COMM_MODE_RTU_EN

        config MB_COMM_MODE_RTU
            bool "RTU mode"
            depends on FMB_COMM_MODE_RTU_EN

        config MB_COMM_MODE_ASCII
            bool "ASCII mode"
            depends on FMB_COMM_MODE_ASCII_EN

    endchoice

endmenu
